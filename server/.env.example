# ============================================================
# Signal Arena — server environment (block 5.3)
# Copy to server/.env and fill in. .env is gitignored — each machine
# keeps its own. NEVER commit a real .env.
# ============================================================

# ── Server ──
NODE_ENV=development
SERVER_PORT=3001
SERVER_HOST=0.0.0.0
LOG_LEVEL=info

# ── JWT ──
# REQUIRED in production (server refuses to start on NODE_ENV=production
# without it). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Database (SQLite by default; PostgreSQL when deployed) ──
DB_USERS_TYPE=sqlite
DB_USERS_SQLITE=
DB_CONTENT_TYPE=sqlite
DB_CONTENT_SQLITE=
# PostgreSQL (prod):
# DB_USERS_PG_HOST=localhost
# DB_USERS_PG_PORT=5432
# DB_USERS_PG_DB=signal_arena_users
# DB_USERS_PG_USER=sa_user
# DB_USERS_PG_PASSWORD=
# DB_CONTENT_PG_RO_USER=sa_content_reader
# DB_CONTENT_PG_RO_PASS=

# ── Redis (game session buffer). Disabled → in-memory buffer. ──
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Message broker (memory | rabbitmq | kafka) ──
BROKER_TYPE=memory

# ── AI (optional; overseer works without a key in stub mode) ──
OPENROUTER_API_KEY=

# ── Rate limiting (requests / window) ──
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
